# Copy to .env and fill in. Leave LLM_PROVIDER=none to run fully offline (rule-based router + templated answers).
LLM_PROVIDER=none
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.5-flash-lite
# GOOGLE_API_KEY=...
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# Dense embeddings (optional). Empty = BM25 only. Re-run ingestion after changing.
EMBEDDINGS=
# EMBEDDINGS=huggingface:sentence-transformers/all-MiniLM-L6-v2
# EMBEDDINGS=openai:text-embedding-3-small
# EMBEDDINGS=ollama:nomic-embed-text

# Only used to rank AED/USD offers next to INR ones.
AED_TO_INR=24.0
